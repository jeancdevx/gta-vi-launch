# Credenciales para activar el radar en vivo en /api/streamers
# Copia este archivo como .env (desarrollo local) o añade estas variables en Vercel.

# Obligatorias para canales de Twitch (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Opcional: activa estado en vivo de canales de YouTube (Google Cloud -> YouTube Data API v3)
YOUTUBE_API_KEY=

# Opcional: pon "false" si prefieres desactivar consultas al endpoint público de Kick
ENABLE_KICK_LIVE=true
