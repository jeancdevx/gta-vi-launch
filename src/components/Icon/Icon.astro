---
type IconName =
  | 'arrow-down'
  | 'arrow-left'
  | 'arrow-right'
  | 'chevron-down'
  | 'search'
  | 'map-pin'
  | 'clock'
  | 'globe'
  | 'plus'
  | 'external'
  | 'check'
  | 'crosshair'
  | 'x'
  | 'shield'
  | 'signal'
  | 'eye-off'
  | 'play'

interface Props {
  name: IconName
  class?: string
  size?: number
}

const { name, class: className, size = 24 } = Astro.props
---

<svg
  viewBox='0 0 24 24'
  width={size}
  height={size}
  fill='none'
  stroke='currentColor'
  stroke-width='1.5'
  stroke-linecap='round'
  stroke-linejoin='round'
  aria-hidden='true'
  focusable='false'
  class={className}
>
  {name === 'arrow-down' && <path d='M12 4v16m0 0 6-6m-6 6-6-6' />}
  {name === 'arrow-left' && <path d='M19 12H5m0 0 6-6m-6 6 6 6' />}
  {name === 'arrow-right' && <path d='M5 12h14m0 0-6-6m6 6-6 6' />}
  {name === 'chevron-down' && <path d='m6 9 6 6 6-6' />}
  {name === 'search' && (
    <>
      <circle cx='11' cy='11' r='7' />
      <path d='m16.5 16.5 5 5' />
    </>
  )}
  {name === 'map-pin' && (
    <>
      <path d='M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z' />
      <circle cx='12' cy='10' r='2.5' />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx='12' cy='12' r='8' />
      <path d='M12 7v5l3 2' />
    </>
  )}
  {name === 'globe' && (
    <>
      <circle cx='12' cy='12' r='8' />
      <path d='M4 12h16M12 4c2.5 2.3 4 5 4 8s-1.5 5.7-4 8c-2.5-2.3-4-5-4-8s1.5-5.7 4-8Z' />
    </>
  )}
  {name === 'plus' && <path d='M12 5v14M5 12h14' />}
  {name === 'external' && (
    <>
      <path d='M14 4h6v6M20 4l-9 9' />
      <path d='M10 5H5v14h14v-5' />
    </>
  )}
  {name === 'check' && <path d='m5 12 4 4L19 6' />}
  {name === 'x' && <path d='M6 6l12 12M18 6 6 18' />}
  {name === 'crosshair' && (
    <>
      <circle cx='12' cy='12' r='7' />
      <path d='M12 2v3M12 19v3M2 12h3M19 12h3' />
    </>
  )}
  {name === 'shield' && (
    <path d='M12 3 5 6v6c0 4.5 3 7.8 7 9 4-1.2 7-4.5 7-9V6l-7-3Z' />
  )}
  {name === 'signal' && (
    <>
      <circle cx='12' cy='12' r='2' />
      <path d='M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.5 5.5a9.2 9.2 0 0 0 0 13M18.5 5.5a9.2 9.2 0 0 1 0 13' />
    </>
  )}
  {name === 'eye-off' && (
    <>
      <path d='M3 3l18 18' />
      <path d='M10.6 10.6a2 2 0 0 0 2.8 2.8' />
      <path d='M9.9 5.2A10.7 10.7 0 0 1 12 5c4.6 0 8.2 3 9.5 7-.6 1.8-1.7 3.4-3.2 4.6' />
      <path d='M6.3 6.3C4.5 7.6 3.2 9.6 2.5 12c1.3 4 4.9 7 9.5 7 1.6 0 3.1-.4 4.4-1' />
    </>
  )}
  {name === 'play' && <path d='M8 6v12l10-6-10-6Z' />}
</svg>
