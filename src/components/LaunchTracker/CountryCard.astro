---
import Icon from '@/components/Icon'
import type { Region } from '@/constants'
import { releaseInstant, utcOffsetLabel } from '@/helpers/release.helpers'

interface Props {
  region: Region
  index: number
}

const { region, index } = Astro.props
const offset = utcOffsetLabel(region.zone)
---

<article
  class='country-card group relative grid country-cols items-center gap-y-1 border-b border-line px-1 py-2.5 transition-colors duration-150 ease-out hover:bg-white/[0.03] data-[selected=true]:bg-vice/[0.06] md:gap-y-0'
  data-region={region.id}
  data-instant={releaseInstant(region.zone)}
  aria-labelledby={`country-${region.id}`}
>
  <span
    class='hidden text-center text-[0.625rem] leading-4 text-[#8f839b] tabular-nums group-data-[selected=true]:text-vice md:col-start-1 md:row-start-1 md:block'
    aria-hidden='true'
  >
    {String(index + 1).padStart(2, '0')}
  </span>

  <div class='col-start-1 row-start-1 flex min-w-0 items-center gap-3 md:col-start-2'>
    <span class='text-xl leading-none' aria-hidden='true'>
      {region.flag}
    </span>
    <div class='min-w-0'>
      <h3
        id={`country-${region.id}`}
        class='truncate text-sm leading-5 font-semibold'
      >
        {region.country}
      </h3>
      <p class='truncate text-xs leading-4 text-muted'>
        {region.city} · {region.continent}
      </p>
    </div>
  </div>

  <div class='col-start-1 row-start-2 flex items-center gap-2 text-xs leading-4 text-muted md:col-start-3 md:row-start-1'>
    <span class='text-[#cfc4d7] tabular-nums'>00:00</span>
    <span class='text-[#7f738c]' aria-hidden='true'>
      ·
    </span>
    <span class='tabular-nums'>{offset}</span>
  </div>

  <div class='col-start-2 row-start-1 text-right md:col-start-4 md:text-left'>
    <p
      class='country-timer text-xs leading-4 font-semibold tracking-[-0.01em] whitespace-nowrap text-[#e9dfee] tabular-nums group-data-[available=true]:text-mint md:text-sm md:leading-5'
      role='timer'
    >
      19 nov · 00:00
    </p>
    <p class='country-status mt-0.5 text-[0.625rem] leading-3 tracking-[0.1em] text-vice uppercase group-data-[available=true]:text-mint'>
      En espera
    </p>
  </div>

  <span
    class='col-start-2 row-start-2 grid size-10 place-items-center justify-self-end border border-white/15 bg-white/[0.03] text-muted transition-[border-color,color,background-color,transform] duration-150 ease-out group-hover:border-vice group-hover:bg-vice/10 group-hover:text-vice group-active:scale-[0.97] group-data-[selected=true]:border-vice/60 group-data-[selected=true]:text-vice md:col-start-5 md:row-span-1 md:row-start-1 md:justify-self-center'
    aria-hidden='true'
  >
    <Icon name='arrow-right' class='size-4' />
  </span>

  <button
    type='button'
    data-choose-region={region.id}
    aria-label={`Ver el contador de ${region.country}`}
    class='absolute inset-0 cursor-pointer focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-vice'
  ></button>
</article>
