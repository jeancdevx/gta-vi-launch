---
import { regions } from '@/constants'

import {
  MAP_SECTORS,
  VICE_CITY,
  createTacticalWorldMap
} from './WorldMap.helpers'

const map = createTacticalWorldMap(regions)
---

<div
  class='gta-radar relative overflow-hidden border border-line bg-[#14111d]'
  role='region'
  aria-label='Mapa táctico mundial de lanzamiento y radar de creadores'
>
  <div class='relative aspect-[1200/560] w-full overflow-hidden bg-[#100d18]'>
    <div
      id='map-stage'
      class='map-stage relative h-full w-full origin-center'
      data-sector='global'
    >
      <svg
        viewBox={`0 0 ${map.width} ${map.height}`}
        aria-hidden='true'
        class='block h-full w-full select-none'
      >
        <defs>
          <clipPath id='world-sphere-clip'>
            <path d={map.spherePath} />
          </clipPath>
          <pattern
            id='tactical-land-dots'
            width='6'
            height='6'
            patternUnits='userSpaceOnUse'
          >
            <circle cx='1.5' cy='1.5' r='0.65' fill='rgba(255,246,239,0.12)' />
          </pattern>
          <linearGradient
            id='signal-arc-gradient'
            x1='0%'
            y1='0%'
            x2='100%'
            y2='0%'
          >
            <stop offset='0%' stop-color='#ffccad' stop-opacity='0.95' />
            <stop offset='50%' stop-color='#f5a5c6' stop-opacity='1' />
            <stop offset='100%' stop-color='#b8e5c1' stop-opacity='0.95' />
          </linearGradient>
        </defs>

        <path
          d={map.spherePath}
          fill='#120f1c'
          stroke='rgba(255,255,255,0.08)'
          stroke-width='0.9'
        />

        <g clip-path='url(#world-sphere-clip)'>
          <path
            d={map.graticulePath}
            fill='none'
            stroke='rgba(255,255,255,0.055)'
            stroke-width='0.65'
          />

          <g class='map-base-land'>
            {map.baseCountriesPaths.map(path => (
              <path
                d={path}
                fill='#241d35'
                stroke='rgba(255,246,239,0.13)'
                stroke-width='0.55'
              />
            ))}
          </g>

          <g class='map-tracked-countries'>
            {map.trackedPolygons.map(poly => (
              <path d={poly.d} data-map-poly={poly.id} class='map-country' />
            ))}
          </g>

          <g class='pointer-events-none opacity-45'>
            {map.trackedPolygons.map(poly => (
              <path d={poly.d} fill='url(#tactical-land-dots)' />
            ))}
          </g>

          <path
            id='map-midnight-line'
            d=''
            fill='none'
            stroke='rgba(255,204,173,0.45)'
            stroke-width='1.2'
            stroke-dasharray='4 4'
          />

          <g class='pointer-events-none opacity-35'>
            {map.ambientArcs.map(arc => (
              <path
                d={arc}
                fill='none'
                stroke='rgba(245,165,198,0.45)'
                stroke-width='0.8'
                stroke-dasharray='3 5'
              />
            ))}
          </g>

          <path
            id='map-active-arc'
            d=''
            fill='none'
            stroke='url(#signal-arc-gradient)'
            stroke-width='1.8'
            stroke-linecap='round'
            class='map-signal-arc'
          />
        </g>

        <g
          transform={`translate(${map.viceCity.x}, ${map.viceCity.y})`}
          class='pointer-events-none'
        >
          <circle
            r='11'
            fill='none'
            stroke='rgba(255,204,173,0.38)'
            stroke-width='0.9'
          />
          <rect
            x='-3.5'
            y='-3.5'
            width='7'
            height='7'
            transform='rotate(45)'
            fill='#ffccad'
            stroke='#111019'
            stroke-width='1'
          />
          <text
            x='10'
            y='3'
            fill='#ffccad'
            font-size='8.5'
            font-weight='700'
            letter-spacing='1.4'
          >
            VICE CITY
          </text>
        </g>
      </svg>

      {map.pins.map(pin => (
        <button
          type='button'
          class='map-blip group absolute grid size-7 -translate-x-1/2 -translate-y-1/2 place-items-center border-0 bg-transparent p-0 text-vice data-[available=true]:text-mint data-[live=true]:text-vice'
          data-map-region={pin.id}
          data-major={String(pin.major)}
          aria-label={`Consultar ${pin.country}, ${pin.city}`}
          style={`left:${pin.leftPct}%;top:${pin.topPct}%`}
        >
          <span
            class='map-blip-ring pointer-events-none absolute size-5 rounded-full border border-current opacity-0 transition-opacity duration-200 ease-out group-aria-pressed:opacity-75 group-data-[live=true]:opacity-75'
            aria-hidden='true'
          ></span>
          <span
            class='map-blip-core relative block size-2 rotate-45 border border-canvas bg-current transition-transform duration-150 ease-out group-aria-pressed:scale-125 group-data-[major=false]:size-1.5'
            aria-hidden='true'
          ></span>
          <span
            class:list={[
              'pointer-events-none absolute bottom-7 z-20 border border-line bg-[#161221]/95 px-2.5 py-1.5 text-[0.6875rem] leading-4 whitespace-nowrap text-ink opacity-0 transition-opacity duration-150 ease-out group-hover:opacity-100 group-focus-visible:opacity-100',
              pin.leftPct > 84
                ? 'right-0 left-auto translate-x-0'
                : pin.leftPct < 16
                  ? 'left-0 translate-x-0'
                  : 'left-1/2 -translate-x-1/2'
            ]}
            aria-hidden='true'
          >
            <span class='font-semibold'>{pin.country}</span>
            <span class='ml-1.5 text-muted'>{pin.city}</span>
          </span>
        </button>
      ))}
    </div>

    <div class='pointer-events-none absolute bottom-4 left-4 z-10 hidden max-w-[320px] border-l-2 border-vice/70 pl-3 md:block'>
      <p class='text-[0.625rem] font-semibold tracking-[0.16em] text-muted uppercase'>
        Región seleccionada
      </p>
      <p class='mt-1 flex items-center gap-2 text-sm leading-5 font-semibold text-ink'>
        <span id='map-hud-flag' aria-hidden='true'>
          🇵🇪
        </span>
        <span id='map-hud-country'>Perú · Lima</span>
      </p>
      <p
        id='map-hud-status'
        class='mt-0.5 text-xs leading-4 font-medium text-mint'
      >
        En espera
      </p>
    </div>
  </div>

  <div class='flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-line px-4 py-2.5 max-[600px]:px-3 md:hidden'>
    <p class='flex min-w-0 items-center gap-2 text-sm leading-5 font-semibold text-ink'>
      <span data-map-hud-flag aria-hidden='true'>
        🇵🇪
      </span>
      <span data-map-hud-country class='truncate'>
        Perú · Lima
      </span>
    </p>
    <p
      data-map-hud-status
      class='text-xs leading-4 font-medium text-mint tabular-nums'
    >
      En espera
    </p>
  </div>

  <div class='flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-line px-4 py-3 text-[0.6875rem] leading-4 text-muted max-[600px]:px-3 max-[600px]:py-2.5'>
    <div class='flex flex-wrap items-center gap-x-5 gap-y-1.5'>
      <span class='inline-flex items-center gap-1.5'>
        <span class='inline-block size-2 rotate-45 bg-peach'></span>
        {VICE_CITY.label}
      </span>
      <span class='inline-flex items-center gap-1.5'>
        <span class='inline-block size-2 rotate-45 bg-mint'></span>
        Disponible
      </span>
      <span class='inline-flex items-center gap-1.5'>
        <span class='inline-block size-2 rotate-45 bg-vice'></span>
        En espera · en directo
      </span>
    </div>
    <div
      class='flex flex-wrap items-center gap-1'
      role='group'
      aria-label='Enfocar sector del mapa'
    >
      <span class='mr-1.5 text-[0.625rem] tracking-[0.14em] uppercase max-[600px]:hidden'>
        Enfocar
      </span>
      {MAP_SECTORS.map((sector, index) => (
        <button
          type='button'
          data-map-sector={sector.id}
          data-sector-transform={sector.transform}
          aria-pressed={index === 0 ? 'true' : 'false'}
          class='min-h-9 border-b border-transparent px-1.5 text-[0.625rem] leading-4 font-semibold tracking-[0.1em] text-muted uppercase transition-colors duration-150 ease-out hover:text-ink aria-pressed:border-vice aria-pressed:text-vice'
        >
          {sector.label}
        </button>
      ))}
    </div>
  </div>
</div>

<script
  id='map-projection-data'
  type='application/json'
  set:html={JSON.stringify({
    meta: map.projectionMeta,
    viceCity: [map.viceCity.x, map.viceCity.y],
    pins: Object.fromEntries(map.pins.map(pin => [pin.id, [pin.x, pin.y]]))
  })}
/>
