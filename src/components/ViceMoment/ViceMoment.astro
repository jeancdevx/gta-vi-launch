---
import { asset } from '@/helpers/assets.helpers'
---

<section class='vice-moment' aria-labelledby='moment-title'>
  <img
    src={asset('rooftop')}
    alt='Arte oficial de Jason y Lucia en una azotea de Vice City'
    width='1920'
    height='1080'
    loading='lazy'
  />
  <div class='moment-shade'></div>
  <div class='wrap moment-content'>
    <p class='eyebrow'>EL DESTINO ES EL MISMO.</p>
    <h2 id='moment-title' class='word-reveal'>
      La misma ciudad.
      <br />
      Millones de primeras veces.
    </h2>
    <p>
      Cada país tiene su hora.
      <br />
      Todos llevamos años esperando este momento.
    </p>
    <a
      href='https://www.rockstargames.com/VI'
      target='_blank'
      rel='noopener noreferrer'
      class='button button-light'
    >
      Entrar al mundo de GTA VI
    </a>
  </div>
  <span class='moment-caption'>JASON & LUCIA · LEONIDA, USA</span>
</section>
