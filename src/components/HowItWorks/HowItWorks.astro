---
import Icon from '@/components/Icon'
import { release } from '@/constants'

import { faqs } from './HowItWorks.constants'

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([question, answer]) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer }
  }))
}
---

<section
  class='explainer wrap pt-24 pb-24 max-[600px]:pt-16 max-[600px]:pb-16'
  id='como-funciona'
  aria-labelledby='explain-title'
>
  <div class='flex items-end justify-between gap-12 max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-6'>
    <div>
      <p class='eyebrow text-vice'>CÓMO SE CALCULA LA HORA.</p>
      <h2
        id='explain-title'
        class='mt-6 max-w-[680px] text-5xl leading-none font-semibold tracking-[-0.04em] max-[600px]:mt-4 max-[600px]:text-4xl max-[600px]:leading-10'
      >
        Tú elige el país.
        <br />
        <span class='text-vice'>Nosotros contamos.</span>
      </h2>
    </div>
    <a
      href={release.source}
      target='_blank'
      rel='noopener noreferrer'
      class='inline-flex items-center gap-2 py-3 text-sm leading-5 text-vice underline underline-offset-[5px] transition-colors duration-200 ease-out hover:text-peach focus-visible:outline-offset-4'
    >
      Consultar horario de Rockstar
      <Icon name='external' class='size-4' />
    </a>
  </div>

  <div
    class='mt-16 grid grid-cols-1 border-t border-line max-[600px]:mt-10 md:grid-cols-3'
    data-reveal
  >
    <article class='border-b border-line py-8 md:border-r md:border-b-0 md:pr-8 md:last:border-r-0'>
      <span class='text-xs font-semibold tracking-[0.18em] text-vice'>01</span>
      <h3 class='mt-5 text-xl leading-7 font-semibold'>Encuentra tu región</h3>
      <p class='mt-3 max-w-[300px] text-base leading-6 text-muted'>
        Elige el país y la ciudad que usarás como referencia. Puedes cambiarla
        cuando quieras.
      </p>
    </article>
    <article class='border-b border-line py-8 md:border-r md:border-b-0 md:px-8 md:last:border-r-0'>
      <span class='text-xs font-semibold tracking-[0.18em] text-vice'>02</span>
      <h3 class='mt-5 text-xl leading-7 font-semibold'>
        Sigue la cuenta regresiva
      </h3>
      <p class='mt-3 max-w-[300px] text-base leading-6 text-muted'>
        Horas, minutos y segundos hasta la medianoche local del 19 de noviembre
        de 2026.
      </p>
    </article>
    <article class='py-8 md:pl-8'>
      <span class='text-xs font-semibold tracking-[0.18em] text-vice'>03</span>
      <h3 class='mt-5 text-xl leading-7 font-semibold'>El mapa se enciende</h3>
      <p class='mt-3 max-w-[300px] text-base leading-6 text-muted'>
        Cuando una región alcanza su medianoche, el contador pasa al tiempo
        transcurrido y el mapa la marca como disponible.
      </p>
    </article>
  </div>

  <div class='mt-24 grid gap-16 border-t border-line pt-12 max-[600px]:mt-12 max-[600px]:gap-6 max-[600px]:pt-8 md:grid-cols-[1fr_2fr]'>
    <h3 class='text-3xl leading-9 font-medium'>Antes de arrancar.</h3>
    <div>
      {faqs.map(([question, answer]) => (
        <details class='group border-b border-line'>
          <summary class='flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-base leading-6 focus-visible:outline-offset-4 max-[600px]:text-sm max-[600px]:leading-5 [&::-webkit-details-marker]:hidden'>
            {question}
            <Icon
              name='plus'
              class='size-6 shrink-0 text-vice transition-transform duration-200 ease-out group-open:rotate-45'
            />
          </summary>
          <p class='max-w-[680px] pb-6 leading-6 text-muted max-[600px]:text-sm max-[600px]:leading-5'>
            {answer}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type='application/ld+json' set:html={JSON.stringify(faqSchema)} />
