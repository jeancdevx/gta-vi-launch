---
import { regions } from '@/constants'
---

<label for='region-select' class='sr-only'>
  Elige tu país o región
</label>
<div class='select-wrap'>
  <select id='region-select' name='region'>
    {regions.map(region => (
      <option value={region.id} selected={region.id === 'pe'}>
        {region.flag} {region.country} · {region.city}
      </option>
    ))}
  </select>
  <svg
    viewBox='0 0 24 24'
    width='20'
    height='20'
    fill='none'
    stroke='currentColor'
    stroke-width='1.5'
    aria-hidden='true'
  >
    <path d='m6 9 6 6 6-6' />
  </svg>
</div>
<div class='extra-zone-wrap' id='extra-zone-wrap' hidden>
  <label for='zone-select'>Zona de referencia</label>
  <div class='select-wrap'>
    <select id='zone-select' name='zone'></select>
    <svg
      viewBox='0 0 24 24'
      width='18'
      height='18'
      fill='none'
      stroke='currentColor'
      stroke-width='1.5'
      aria-hidden='true'
    >
      <path d='m6 9 6 6 6-6' />
    </svg>
  </div>
</div>
