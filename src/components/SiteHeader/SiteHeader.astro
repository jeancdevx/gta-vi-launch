---
import { asset } from '@/helpers/assets.helpers'
---

<header class='absolute top-0 left-1/2 z-30 flex w-[calc(100%-6rem)] max-w-[1280px] -translate-x-1/2 items-center justify-between gap-6 py-6 max-[900px]:w-[calc(100%-3rem)] max-[900px]:py-5 max-[600px]:w-[calc(100%-2rem)]'>
  <a
    href='/'
    class='inline-flex items-center gap-3 focus-visible:outline-offset-4'
    aria-label='GTA VI Launch, inicio'
  >
    <img
      src={asset('fullLogo')}
      width='116'
      height='116'
      alt=''
      class='h-11 w-11 object-contain max-[600px]:h-9 max-[600px]:w-9'
    />
    <span class='text-sm leading-4 font-bold tracking-[0.22em] uppercase'>
      GTA VI
      <span class='mt-1 block text-[0.625rem] font-normal tracking-[0.18em] text-[#d8c9d9]'>
        Launch tracker
      </span>
    </span>
  </a>

  <div class='flex items-center gap-8 max-[600px]:gap-4'>
    <nav
      aria-label='Navegación principal'
      class='flex gap-7 text-sm leading-5 max-[900px]:hidden'
    >
      <a
        href='#paises'
        class='py-2 transition-colors duration-200 ease-out hover:text-vice focus-visible:outline-offset-4'
      >
        Tablero
      </a>
      <a
        href='#como-funciona'
        class='py-2 transition-colors duration-200 ease-out hover:text-vice focus-visible:outline-offset-4'
      >
        Cómo funciona
      </a>
    </nav>
    <a
      href='#mi-region'
      class='relative inline-flex items-center gap-2 py-2 text-sm leading-5 font-semibold text-vice transition-colors duration-200 ease-out after:absolute after:right-0 after:bottom-0 after:left-0 after:h-px after:w-0 after:bg-peach after:transition-[width] after:duration-200 after:ease-out hover:text-peach hover:after:w-full focus-visible:outline-offset-4 focus-visible:after:w-full'
    >
      Mi región
      <span aria-hidden='true'>↓</span>
    </a>
  </div>
</header>
