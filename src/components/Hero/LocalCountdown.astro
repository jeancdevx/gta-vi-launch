---
import RegionPicker from '@/components/RegionPicker'
---

<section
  class='group mt-14 w-full scroll-mt-8 max-[900px]:mt-10'
  id='mi-region'
  aria-labelledby='region-heading'
>
  <div class='grid border-t border-white/25 max-[900px]:border-white/20 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)_minmax(0,0.9fr)]'>
    <div class='py-6 md:pr-8'>
      <p class='eyebrow text-peach' id='region-heading'>
        Tu región
      </p>
      <RegionPicker />
    </div>

    <div class='border-t border-white/15 py-6 max-[900px]:border-white/15 md:border-t-0 md:border-l md:px-8'>
      <div class='flex items-center justify-between gap-4'>
        <span
          class='eyebrow text-muted transition-colors duration-300 ease-out group-[.has-launched]:text-mint'
          id='local-status'
        >
          EN CUENTA REGRESIVA
        </span>
      </div>
      <div
        class='mt-4 flex flex-wrap items-baseline gap-x-2 tabular-nums'
        role='timer'
        aria-label='Tiempo hasta el lanzamiento'
        id='hero-clock'
      >
        <span
          class='text-6xl leading-none font-bold tracking-[-0.05em] max-[600px]:text-5xl'
          id='clock-hours'
        >
          ··
        </span>
        <span class='text-sm leading-none text-muted'>h</span>
        <span
          class='text-6xl leading-none font-bold tracking-[-0.05em] max-[600px]:text-5xl'
          id='clock-minutes'
        >
          ··
        </span>
        <span class='text-sm leading-none text-muted'>m</span>
        <span
          class='text-6xl leading-none font-bold tracking-[-0.05em] max-[600px]:text-5xl'
          id='clock-seconds'
        >
          ··
        </span>
        <span class='text-sm leading-none text-muted'>s</span>
      </div>
      <p class='mt-3 text-xs leading-4 text-muted' id='countdown-label'>
        Para la medianoche del lanzamiento
      </p>
    </div>

    <div class='border-t border-white/15 py-6 max-[900px]:border-white/15 md:border-t-0 md:border-l md:pl-8'>
      <p class='eyebrow text-muted'>Hora de referencia</p>
      <p
        id='local-release'
        class='mt-3 text-base leading-6 font-semibold tracking-[0.02em] text-peach'
      >
        19 NOV 2026 · 00:00 · Lima
      </p>
      <p class='mt-2 max-w-[300px] text-xs leading-4 text-muted'>
        Según el horario regional de Rockstar. La tienda de tu cuenta manda.
      </p>
      <p class='sr-only' id='selection-feedback' role='status'></p>
    </div>
  </div>
</section>
