---
import Icon from '@/components/Icon'
import RegionPicker from '@/components/RegionPicker'
---

<section
  class='group mt-10 w-full scroll-mt-8 max-[600px]:mt-8'
  id='mi-region'
  aria-labelledby='region-heading'
>
  <div class='grid border-t border-white/25 max-[900px]:border-white/20 md:grid-cols-[minmax(0,1.15fr)_minmax(0,1.1fr)_minmax(0,0.95fr)]'>
    <div class='py-5 md:pr-8'>
      <p class='eyebrow text-peach' id='region-heading'>
        Tu región
      </p>
      <RegionPicker />
    </div>

    <div class='border-t border-white/15 py-5 max-[900px]:border-white/15 md:border-t-0 md:border-l md:px-8'>
      <div class='flex items-center justify-between gap-4'>
        <span
          class='eyebrow text-muted transition-colors duration-300 ease-out group-[.has-launched]:text-mint'
          id='local-status'
        >
          EN CUENTA REGRESIVA
        </span>
      </div>
      <div
        class='mt-4 flex flex-nowrap items-baseline gap-x-1 whitespace-nowrap tabular-nums'
        role='timer'
        aria-label='Tiempo hasta el lanzamiento'
        id='hero-clock'
      >
        <span
          id='clock-days-wrap'
          class='inline-flex items-baseline gap-x-1.5'
          hidden
        >
          <span
            class='text-[clamp(2.5rem,5.2vw,3.5rem)] leading-none font-bold tracking-[-0.05em]'
            id='clock-days'
          >
            00
          </span>
          <span class='text-sm leading-none text-muted'>d</span>
        </span>
        <span
          class='text-[clamp(2.5rem,5.2vw,3.5rem)] leading-none font-bold tracking-[-0.05em]'
          id='clock-hours'
        >
          ··
        </span>
        <span class='text-sm leading-none text-muted'>h</span>
        <span
          class='text-[clamp(2.5rem,5.2vw,3.5rem)] leading-none font-bold tracking-[-0.05em]'
          id='clock-minutes'
        >
          ··
        </span>
        <span class='text-sm leading-none text-muted'>m</span>
        <span
          class='text-[clamp(2.5rem,5.2vw,3.5rem)] leading-none font-bold tracking-[-0.05em]'
          id='clock-seconds'
        >
          ··
        </span>
        <span class='text-sm leading-none text-muted'>s</span>
      </div>
      <p class='mt-3 text-xs leading-4 text-muted' id='countdown-label'>
        Para la medianoche del lanzamiento
      </p>
    </div>

    <div class='border-t border-white/15 py-5 max-[900px]:border-white/15 md:border-t-0 md:border-l md:pl-8'>
      <p class='eyebrow text-muted'>Hora de referencia</p>
      <p
        id='local-release'
        class='mt-3 text-[0.8125rem] leading-5 font-semibold tracking-[0.02em] text-peach lg:text-base'
      >
        19 NOV 2026 · 00:00
      </p>
      <p class='mt-2 max-w-[300px] text-xs leading-4 text-muted'>
        Hora publicada. La tienda de tu cuenta manda.
      </p>
      <a
        href='#radar-streamers'
        id='hero-streamer-pulse'
        hidden
        class='mt-3 inline-flex items-center gap-1.5 text-xs leading-4 font-semibold text-vice transition-colors duration-150 ease-out hover:text-peach focus-visible:outline-offset-4'
      >
        <Icon name='signal' size={13} class='shrink-0' />
        <span id='hero-streamer-pulse-text'>Radar de creadores</span>
      </a>
      <p class='sr-only' id='selection-feedback' role='status'></p>
    </div>
  </div>
</section>
