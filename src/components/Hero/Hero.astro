---
import Icon from '@/components/Icon'
import { asset } from '@/helpers/assets.helpers'

import LocalCountdown from './LocalCountdown.astro'
---

<section
  id='hero-section'
  data-phase='countdown'
  class='hero relative isolate flex min-h-svh flex-col justify-end overflow-clip bg-[#211729]'
>
  <div class='absolute inset-0 -z-10 overflow-hidden' aria-hidden='true'>
    <img
      src={asset('hero')}
      alt=''
      width='1920'
      height='1080'
      fetchpriority='high'
      decoding='async'
      class='hero-background absolute h-full w-full object-cover object-[62%_center] max-[900px]:object-[65%_center] max-[600px]:object-[61%_center] min-[1600px]:object-center'
    />
    <div class='absolute inset-0 bg-gradient-to-r from-canvas/80 via-canvas/35 to-transparent'></div>
    <div class='absolute inset-0 bg-gradient-to-t from-canvas/85 via-canvas/25 to-transparent'></div>
    <div class='absolute inset-x-0 top-0 h-48 bg-gradient-to-b from-canvas/65 to-transparent'></div>
  </div>

  <div class='wrap flex flex-1 flex-col justify-end pt-36 pb-0 max-[600px]:pt-28'>
    <div class='hero-copy max-w-3xl'>
      <p class='flex items-center gap-3 eyebrow text-peach'>
        <span class='h-px w-8 bg-peach' aria-hidden='true'></span>
        <span id='hero-eyebrow'>19 NOV 2026 · LANZAMIENTO MUNDIAL</span>
      </p>
      <h1
        id='hero-title'
        class='mt-6 text-8xl leading-[0.92] font-bold tracking-[-0.055em] max-[1150px]:text-7xl max-[600px]:text-5xl max-[600px]:leading-[0.98] max-[359px]:text-4xl min-[1600px]:text-7xl'
      >
        <span id='hero-title-main'>Vice City abre</span>
        <br class='max-[600px]:hidden' />
        <span id='hero-title-accent' class='text-vice'>
          {' '}
          a medianoche.
        </span>
      </h1>
      <p
        id='hero-subtitle'
        class='mt-6 max-w-[480px] text-lg leading-7 text-ink/80 max-[600px]:text-base max-[600px]:leading-6'
      >
        Elige tu país y sigue la hora local de referencia. Consulta también los
        canales que cubren el lanzamiento.
      </p>
      <p class='mt-5 text-xs leading-4 font-bold tracking-[0.12em] text-[#d9b7c9]'>
        PLAYSTATION 5
        <span class='mx-2 font-normal text-[#9b7f90]' aria-hidden='true'>
          ·
        </span>
        XBOX SERIES X|S
      </p>
    </div>

    <LocalCountdown />

    <div class='flex flex-wrap items-center justify-between gap-4 py-5 text-xs leading-4 text-[#c1b1c4] max-[600px]:py-4'>
      <a
        href='#paises'
        class='inline-flex min-h-11 items-center gap-3 transition-colors duration-200 ease-out hover:text-vice focus-visible:outline-offset-4'
      >
        <span class='inline-block h-6 w-px bg-vice' aria-hidden='true'></span>
        <span id='hero-scroll-label'>Ver el mapa y los 40 países</span>
        <Icon name='arrow-down' class='size-4' />
      </a>

      <a
        href='#radar-streamers'
        class='inline-flex min-h-11 items-center gap-2 text-peach transition-colors duration-200 ease-out hover:text-vice focus-visible:outline-offset-4'
      >
        <Icon name='signal' size={15} class='shrink-0' />
        <span id='hero-radar-cta'>Creadores por país</span>
      </a>
    </div>
  </div>
</section>
