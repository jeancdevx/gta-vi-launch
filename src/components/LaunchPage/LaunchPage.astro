---
import BaseLayout from '@/components/BaseLayout'
import Hero from '@/components/Hero'
import HowItWorks from '@/components/HowItWorks'
import LaunchTracker from '@/components/LaunchTracker'
import SiteFooter from '@/components/SiteFooter'
import SiteHeader from '@/components/SiteHeader'
import ViceMoment from '@/components/ViceMoment'
import { asset } from '@/helpers/assets.helpers'
---

<BaseLayout>
  <Fragment slot='head'>
    <link
      rel='preload'
      as='image'
      href={asset('hero')}
      type='image/webp'
      fetchpriority='high'
    />
  </Fragment>
  <SiteHeader />
  <main id='contenido'>
    <Hero />
    <LaunchTracker />
    <ViceMoment />
    <HowItWorks />
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  import './LaunchPage.animations'
</script>
